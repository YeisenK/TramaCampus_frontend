# Builds the Flutter web app and serves it with nginx.
#
# Usage:
#   docker build -f Dockerfile.web \
#     --build-arg TRAMA_API_BASE=https://api.example.com \
#     -t trama-frontend-web .
#   docker run -p 8081:80 trama-frontend-web
#
# Pinned to Flutter 3.38.3 (Dart 3.10) to match pubspec.yaml.
# The matching API base URL must be baked in at build time because
# `--dart-define` resolves at compile time. Re-build with a new
# TRAMA_API_BASE when the tunnel hostname changes.

# ---- builder ----
FROM ghcr.io/cirruslabs/flutter:3.38.3 AS builder

ARG TRAMA_API_BASE=http://localhost:8080
ARG TRAMA_USE_API_MATCHING=true

WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .

RUN flutter build web --release \
    --dart-define=TRAMA_API_BASE=${TRAMA_API_BASE} \
    --dart-define=TRAMA_USE_API_MATCHING=${TRAMA_USE_API_MATCHING}

# ---- runtime ----
FROM nginx:1.27-alpine
COPY --from=builder /app/build/web /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget -q --spider http://localhost/ || exit 1
